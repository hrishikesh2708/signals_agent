# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=signals-langraph-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Logging
LOG_LEVEL=INFO

# Optional default user name for CLI invokes (Studio: set user_name in input JSON)
SIGNALS_DEFAULT_USER_NAME=

# Salesforce OAuth (required when calling SalesforceConnector.auth_url / exchange)
# Connected App Callback URL must equal SF_CALLBACK_URL exactly (not just http://localhost:8000).
# Redirect URI must equal {API_BASE_URL}{oauth.callback_path} from salesforce.yaml
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_CALLBACK_URL=http://localhost:8000/connections/sources/salesforce/callback
SF_OAUTH_SCOPE=
SF_LOGIN_URL=https://login.salesforce.com

# HubSpot OAuth (required when calling HubSpotConnector auth/exchange)
# Redirect URI must equal {API_BASE_URL}{oauth.callback_path} from hubspot.yaml
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/connections/sources/hubspot/callback
HUBSPOT_SCOPES=

# Zoho OAuth (required when calling ZohoConnector auth/exchange)
# Redirect URI must equal {API_BASE_URL}{oauth.callback_path} from zoho.yaml
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/connections/sources/zoho/callback
ZOHO_SCOPES=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Meta destination OAuth (meta_capi)
# Redirect URI must equal {API_BASE_URL}{oauth.callback_path} from meta_capi.yaml
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=http://localhost:8000/connections/destinations/meta_capi/callback
META_OAUTH_SCOPE=ads_management,business_management

# Google destination OAuth (google_offline_conversions / google_customer_match)
# Redirect URI must equal {API_BASE_URL}{oauth.callback_path} from the destination YAML
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/connections/destinations/google_offline_conversions/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/adwords
# Required for live Ads API checks (listAccessibleCustomers) after Google connect.
# When empty, OAuth still works; dry-run skips the Ads API call.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_API_VERSION=v21

# PostgreSQL (FastAPI + SQLAlchemy async — use psycopg driver)
DATABASE_URL=postgresql+psycopg://signals:signals@localhost:5432/signals

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
# Next.js origin (CORS / links). OAuth callback closes the popup via HTML postMessage.
CLIENT_URL=http://localhost:3000
# Use at least 32 random characters (PyJWT recommends >= 32 bytes for HS256).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Next.js client / CopilotKit
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side BFF proxy target (Next.js route handlers; defaults to NEXT_PUBLIC_API_URL)
BACKEND_URL=http://localhost:8000
